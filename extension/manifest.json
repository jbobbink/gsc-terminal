{
  "manifest_version": 3,
  "name": "GSC Terminal",
  "version": "1.2.0",
  "description": "Replaces Search Console performance reports with TradingView-style candlestick charts and indicators.",
  "action": { "default_title": "Open GSC Terminal", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/webmasters.readonly"]
  },
  "content_scripts": [
    {
      "matches": ["https://search.google.com/search-console*", "https://search.google.com/u/*"],
      "js": ["gsc-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://search.google.com/search-console*", "https://search.google.com/u/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["chart.html", "chart.css", "chart.js", "lib/*"],
    "matches": ["https://search.google.com/*"]
  }]
}
